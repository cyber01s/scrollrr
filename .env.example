# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Neon / Postgres config
storage_POSTGRES_PRISMA_URL=""
storage_POSTGRES_USER=""
storage_DATABASE_URL=""
storage_POSTGRES_URL=""
storage_PGDATABASE=""
storage_VITE_NEON_AUTH_URL=""
storage_POSTGRES_HOST=""
storage_POSTGRES_PASSWORD=""
storage_PGHOST=""
storage_PGPASSWORD=""
storage_NEON_AUTH_BASE_URL=""
storage_NEON_PROJECT_ID=""
storage_POSTGRES_URL_NO_SSL=""
storage_POSTGRES_DATABASE=""
storage_DATABASE_URL_UNPOOLED=""
storage_PGHOST_UNPOOLED=""
storage_POSTGRES_URL_NON_POOLING=""
storage_PGUSER=""

# Upstash Redis config
scrollr_KV_URL=""
scrollr_REDIS_URL=""
scrollr_KV_REST_API_TOKEN=""
scrollr_KV_REST_API_READ_ONLY_TOKEN=""
scrollr_KV_REST_API_URL=""

# Next/Gemini
NEXT_PUBLIC_GEMINI_API_KEY=""

# Impact Affiliate API
IMPACT_PROGRAM_ID=""
IMPACT_AUTH_TOKEN=""
IMPACT_ACCOUNT_SID=""
