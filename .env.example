# ==============================================================================
# REQUIRED: Impact.com Affiliate API Credentials
# ==============================================================================
# Without these, the app will show "End of feed" with no products
# 
# Get from: Your Impact.com Account → Settings → API
# - IMPACT_ACCOUNT_SID: Your account ID (7-8 digits)
# - IMPACT_AUTH_TOKEN: Your API authentication token
# - IMPACT_PROGRAM_ID: Your program/campaign ID (7 digits)
#
# ⚠️  PRODUCTION: Set these in Vercel Dashboard → Settings → Environment Variables
# ⚠️  LOCAL DEV: Copy to .env.local (git ignored, stays private)
# ⚠️  NEVER commit credentials to git!

IMPACT_ACCOUNT_SID="your-account-sid-here"
IMPACT_AUTH_TOKEN="your-auth-token-here"
IMPACT_PROGRAM_ID="your-program-id-here"

# ==============================================================================
# OPTIONAL: Google Gemini API (for AI product descriptions)
# ==============================================================================
GEMINI_API_KEY="your-gemini-api-key"
NEXT_PUBLIC_GEMINI_API_KEY=""

# ==============================================================================
# OPTIONAL: Database & Caching (for production scale)
# ==============================================================================
DATABASE_URL="postgresql://user:password@host:5432/dbname"
UPSTASH_REDIS_URL="redis://..."
UPSTASH_REDIS_TOKEN="token"

# ==============================================================================
# Environment
# ==============================================================================
NODE_ENV="development"

