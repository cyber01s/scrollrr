# Impact.com Affiliate API Credentials (REQUIRED)
# All products and affiliate links are fetched from Impact.com
# Get these from your Impact.com account dashboard
IMPACT_ACCOUNT_SID="your-account-sid"
IMPACT_AUTH_TOKEN="your-auth-token"
IMPACT_PROGRAM_ID="your-program-id"

# Google Gemini API Key (Optional - for AI product descriptions)
GEMINI_API_KEY="your-gemini-api-key"

# Database (Optional)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Redis Cache (Optional)
UPSTASH_REDIS_URL="redis://..."
UPSTASH_REDIS_TOKEN="token"

# Environment
NODE_ENV=development
NEXT_PUBLIC_GEMINI_API_KEY=
